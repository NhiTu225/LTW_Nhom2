<?php
// FILE CẤU HÌNH KẾT NỐI DATABASE (DÙNG CHUNG CHO CẢ NHÓM)

// 1. CẤU HÌNH THÔNG SỐ MYSQL THẬT (Khi nào kết nối DB thật thì điền ở đây)
define('DB_HOST', 'localhost');
define('DB_NAME', 'ltw_nhom2'); // Tên database của nhóm bạn
define('DB_USER', 'root');      // Tài khoản mặc định của XAMPP
define('DB_PASS', '');          // Mật khẩu mặc định của XAMPP (thường để trống)

try {
    // Thử kết nối với MySQL thật trước
    // Nếu database 'ltw_nhom2' chưa tồn tại hoặc chưa bật MySQL trên XAMPP, nó sẽ nhảy vào khối catch
    $pdo = new PDO("mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=utf8", DB_USER, DB_PASS);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    $pdo->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);

} catch (PDOException $e) {
    // 🔥 CƠ CHẾ DỰ PHÒNG CHO KHÁNH TEST UI (MOCK DATABASE TRÊN RAM)
    // Nếu lỗi kết nối MySQL thật, tự động khởi tạo DB ảo để trang web không bị sập Fatal Error
    try {
        $pdo = new PDO('sqlite::memory:');
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

        // Tự động tạo bảng sách ảo để chạy mượt các hàm prepare() ngoài Client
        // SỬA DÒNG NÀY: Thay AUTO_INCREMENT thành AUTOINCREMENT (Bỏ dấu gạch dưới)
        $pdo->exec("CREATE TABLE IF NOT EXISTS books (
            id INTEGER PRIMARY KEY AUTOINCREMENT, 
            title TEXT,
            price REAL,
            old_price REAL,
            image TEXT,
            sale TEXT,
            category TEXT,
            is_flashsale INTEGER DEFAULT 0
        )");

        // Tự động bơm dữ liệu mẫu chuẩn Fahasa nếu bảng trống
        $check = $pdo->query("SELECT COUNT(*) FROM books")->fetchColumn();
        if ($check == 0) {
            $mock_books = [
                ['Sự Mệnh Hail Mary - Project Hail Mary', 125400, 300000, 'Hail+Mary', '40%', 'it', 1],
                ['Linh Tính Và Lý Trí - Các Tiểu Luận Phê Bình', 77000, 110000, 'Linh+Tinh', '30%', 'skills', 1],
                ['Không Gia Đình - Nobody\'s Boy - Tập 1', 67000, 85000, 'Khong+Gia+Dinh+1', '21%', 'skills', 1],
                ['The Wonderful Wizard of Oz - Phù Thủy Xứ Oz', 67000, 148000, 'Wizard+Oz', '55%', 'it', 1],
                ['Không Gia Đình - Nobody\'s Boy - Tập 2', 67000, 99000, 'Khong+Gia+Dinh+2', '32%', 'skills', 1],
                ['Kinh Tế Vĩ Mô Cho Người Khởi Nghiệp', 180000, 240000, 'Economics', '25%', 'economy', 0],
                ['Tâm Lý Học Hành Vi Khách Hàng', 115000, 170000, 'Psychology', '32%', 'economy', 0],
                ['Sách Lập Trình PHP Cho Người Lười', 150000, 250000, 'PHP_Book', '40%', 'it', 0],
                ['Nghệ Thuật Hack UI/UX Bằng Bootstrap', 120000, 200000, 'Bootstrap_UX', '40%', 'it', 0]
            ];

            $insert_sql = "INSERT INTO books (title, price, old_price, image, sale, category, is_flashsale) VALUES (?, ?, ?, ?, ?, ?, ?)";
            $stmt = $pdo->prepare($insert_sql);
            foreach ($mock_books as $b) {
                $stmt->execute($b);
            }
        }
    } catch (PDOException $sqlite_e) {
        die("Không thể khởi tạo cơ sở dữ liệu dự phòng: " . $sqlite_e->getMessage());
    }
}